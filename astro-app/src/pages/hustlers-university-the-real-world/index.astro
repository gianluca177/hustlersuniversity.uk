---
import Layout from "../../layouts/Layout.astro";
import GoldButton from "../../components/GoldButton.astro";
---

<Layout
  title="Hustlers University is Now The Real World"
  description="Official transition page from Hustlers University to The Real World."
>

<main class="relative min-h-screen text-white font-outfit">

  <!-- FIXED BACKGROUND -->
  <div class="fixed inset-0 -z-10 bg-cover bg-center bg-no-repeat"
       style="background-image:url('/background-placeholder.jpg')"></div>

  <!-- DARK OVERLAY -->
  <div class="fixed inset-0 -z-10 bg-[#061322]/90"></div>

  <!-- HERO -->
  <section class="pt-32 pb-20 text-center px-6">

    <div class="flex justify-center items-center gap-8 mb-10">

      <div class="opacity-40 relative w-28">
        <img src="/hu-logo.png" class="w-full" />
        <div class="absolute inset-0 flex items-center justify-center">
          <div class="w-full h-[2px] bg-red-500 rotate-12"></div>
        </div>
      </div>

      <span class="text-3xl text-white">→</span>

      <div class="w-32">
        <img src="/trw-logo.png" class="w-full" />
      </div>

    </div>

    <h1 class="text-4xl md:text-6xl font-semibold leading-tight">
      Hustlers University is Now
      <span class="text-white">The Real World</span>
    </h1>

    <p class="mt-6 max-w-2xl mx-auto text-white/70">
      The platform has evolved into a more advanced, structured system built for modern digital income and long-term skill development.
    </p>

  </section>

<!-- CENTER CARD -->
<section class="pb-36 px-6 overflow-hidden">

  <div class="max-w-2xl mx-auto animate-slideIn">

    <div class="bg-gradient-to-b from-[#10263F] to-[#091B2E]
                border border-white/5 rounded-[12px]
                p-14 text-center
                shadow-[0_40px_120px_rgba(0,0,0,0.65)]">

      <!-- CURRENT SPACES -->
      <p class="text-sm uppercase tracking-wide text-[var(--accent-gold)] font-semibold mb-3">
        CURRENT SPACES LEFT
      </p>

      <div id="spacesLeft"
           class="text-6xl font-semibold mb-8 text-[var(--accent-gold)]
                  drop-shadow-[0_0_14px_rgba(255,207,35,0.25)]">
        312
      </div>

      <!-- PRICE -->
      <p class="text-[#FFFFFFBA] text-lg mb-2">
        Join The Real World & Lock-in Price for
      </p>

      <p class="text-[#FFFFFFBA] text-xl mb-10">
        Only <span class="line-through opacity-60">$147</span>
        <span class="text-white font-semibold">$99.99/Monthly</span>
      </p>

      <!-- HURRY -->
      <h3 class="text-lg font-semibold mb-6">
        <a id="dynamicHurry"
           href="#"
           class="text-[var(--accent-gold)] transition-all duration-300 hover:underline">
          HURRY! SPACES LEFT AT $99 A MONTH AS OF <span id="dynamicDate"></span> IS LOW
        </a>
      </h3>

      <!-- CTA BUTTON -->
      <div class="relative inline-block w-full max-w-sm">

        <button id="dropdownBtn"
          class="ca_btn w-full">
          JOIN THE REAL WORLD
        </button>

        <!-- DROPDOWN -->
        <div id="dropdownMenu"
          class="absolute bottom-full mb-3 w-full bg-black
                 border border-[var(--accent-gold)]
                 rounded-xl overflow-hidden
                 opacity-0 translate-y-6 pointer-events-none
                 transition-all duration-300 ease-out">

          <a href="#" class="block px-6 py-3 hover:bg-[var(--accent-gold)] hover:text-black">
            Conquer (1 Month)
          </a>

          <a href="#" class="block px-6 py-3 hover:bg-[var(--accent-gold)] hover:text-black">
            Conquer (1 Year)
          </a>

          <a href="#" class="block px-6 py-3 hover:bg-[var(--accent-gold)] hover:text-black">
            Vanguard (1 Year)
          </a>

        </div>

      </div>

      <!-- DISCLAIMER -->
      <p class="mt-12 text-[#FFFFFFBA] text-sm flex items-center justify-center gap-3">

        <span class="text-lg opacity-70">$</span>

        Limited Spaces Available at $99 for
        <span id="dynamicDate2"></span>.
        Before Price Increases to $147

        <span class="text-[var(--accent-gold)] font-medium">
          Act fast.
        </span>

        <GoldButton
  id="dropdownBtn"
  text="JOIN THE REAL WORLD"
  fullWidth={true}
/>

      </p>

    </div>

  </div>

</section>

</main>


</Layout>