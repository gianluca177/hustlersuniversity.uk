---
import Layout from "../../layouts/Layout.astro";
---

<Layout
  title="Hustlers University is Now The Real World"
  description="Official transition page from Hustlers University to The Real World."
>

<main class="relative min-h-screen text-white font-outfit">

  <!-- FIXED BACKGROUND -->
  <div class="fixed inset-0 -z-10 bg-cover bg-center bg-no-repeat"
       style="background-image:url('/background-placeholder.jpg')"></div>

  <!-- DARK OVERLAY -->
  <div class="fixed inset-0 -z-10 bg-[#061322]/90"></div>

  <!-- HERO -->
  <section class="pt-32 pb-20 text-center px-6">

    <div class="flex justify-center items-center gap-8 mb-10">

      <div class="opacity-40 relative w-28">
        <img src="/hu-logo.png" class="w-full" />
        <div class="absolute inset-0 flex items-center justify-center">
          <div class="w-full h-[2px] bg-red-500 rotate-12"></div>
        </div>
      </div>

      <span class="text-3xl text-white">→</span>

      <div class="w-32">
        <img src="/trw-logo.png" class="w-full" />
      </div>

    </div>

    <h1 class="text-4xl md:text-6xl font-semibold leading-tight">
      Hustlers University is Now
      <span class="text-white">The Real World</span>
    </h1>

    <p class="mt-6 max-w-2xl mx-auto text-white/70">
      The platform has evolved into a more advanced, structured system built for modern digital income and long-term skill development.
    </p>

  </section>

  <!-- CENTER CARD -->
<section class="pb-36 px-6">

  <div class="relative max-w-2xl mx-auto">

    <!-- Ambient Gold Glow Behind Card -->
    <div class="absolute -inset-8 bg-gradient-to-b from-[#FFC700]/8 via-transparent to-transparent blur-3xl rounded-[28px]"></div>

    <!-- Card -->
    <div class="relative bg-gradient-to-b from-[#10263F] to-[#091B2E]
                border border-white/5 rounded-[20px]
                p-12 md:p-16 text-center
                shadow-[0_40px_120px_rgba(0,0,0,0.65)]">

      <!-- Heading -->
      <h2 class="text-4xl md:text-5xl font-semibold tracking-tight mb-3">
        THE CHOICE IS YOURS
      </h2>

      <p class="text-white/60 mb-10">
        Secure Your Spot Before Pricing Increases
      </p>

      <!-- WISTIA PLACEHOLDER -->
      <div class="aspect-video bg-black rounded-xl mb-12 shadow-lg"></div>

      <!-- URGENCY -->
      <h3 class="text-lg font-semibold">
        HURRY! SPACES LEFT AT $99 A MONTH
      </h3>

      <p class="text-white/50 mt-2 mb-10">
        As of February 28th is low
      </p>

      <!-- TIMER -->
      <div class="grid grid-cols-4 gap-8 mb-10 text-center font-outfit">
        <div>
          <div class="text-5xl font-medium">00</div>
          <div class="text-sm text-white/50">Days</div>
        </div>
        <div>
          <div class="text-5xl font-medium">00</div>
          <div class="text-sm text-white/50">Hours</div>
        </div>
        <div>
          <div class="text-5xl font-medium">00</div>
          <div class="text-sm text-white/50">Minutes</div>
        </div>
        <div>
          <div class="text-5xl font-medium">00</div>
          <div class="text-sm text-white/50">Seconds</div>
        </div>
      </div>

      <!-- GIF BAR PLACEHOLDER -->
      <div class="mb-12">
        <div class="h-6 bg-white/10 rounded-md">
          <!-- GIF placeholder -->
        </div>
      </div>

      <!-- CURRENT SPACES -->
      <p class="text-sm uppercase tracking-wide text-[#FFC700] font-semibold mb-3">
        CURRENT SPACES LEFT
      </p>

      <div id="spacesLeft"
           class="text-6xl font-semibold mb-8 text-[#FFC700]
                  drop-shadow-[0_0_14px_rgba(255,199,0,0.25)]">
        312
      </div>

      <p class="text-white/70">
        Join The Real World & Lock-in Price for
      </p>

      <p class="mt-3 mb-10 text-lg">
        <span class="line-through text-white/30">$147</span>
        <span class="text-white font-semibold">$99.99 / Monthly</span>
      </p>

      <!-- CTA BUTTON -->
      <div class="relative inline-block w-full max-w-sm font-montserrat">

        <button id="dropdownBtn"
          class="w-full py-4 rounded-xl text-white bg-black
                 border border-[#FFC700]
                 transition-all duration-300 ease-out
                 hover:bg-[#FFC700] hover:text-black
                 hover:shadow-[0_0_40px_rgba(255,199,0,0.4)]
                 hover:scale-[1.02]">
          JOIN THE REAL WORLD
        </button>

        <!-- DROPDOWN (ANIMATES UPWARD) -->
        <div id="dropdownMenu"
          class="absolute bottom-full mb-3 w-full bg-black
                 border border-[#FFC700]
                 rounded-xl overflow-hidden
                 opacity-0 translate-y-6 pointer-events-none
                 transition-all duration-300 ease-out">

          <a href="#" class="block px-6 py-3 hover:bg-[#FFC700] hover:text-black">
            Conquer (1 Month)
          </a>

          <a href="#" class="block px-6 py-3 hover:bg-[#FFC700] hover:text-black">
            Conquer (1 Year)
          </a>

          <a href="#" class="block px-6 py-3 hover:bg-[#FFC700] hover:text-black">
            Vanguard (1 Year)
          </a>

        </div>

      </div>

      <!-- DISCLAIMER LINE -->
      <p class="mt-12 text-sm text-white/60 flex items-center justify-center gap-3">

        <!-- ICON PLACEHOLDER -->
        <span class="text-xl text-white/70">$</span>

        Limited Spaces Available at $99 for February 28th.
        Before Price Increases to $147

        <span class="text-[#FFC700] font-medium">
          Act fast.
        </span>

      </p>

    </div>

  </div>

</section>

</main>


</Layout>