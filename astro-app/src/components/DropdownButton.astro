---
interface Props {
  label: string;
}

const { label } = Astro.props;
---

<div class="dropdown-wrapper">

  <button class="gold-btn">
    {label}
  </button>

  <div class="dropdown-menu">
    <a href="#">Conquer (1 Month)</a>
    <a href="#">Conquer (1 Year)</a>
    <a href="#">Vanguard (1 Year)</a>
  </div>

</div>

<style>
  :root {
    --accent-gold: #FFCF23;
  }

  .dropdown-wrapper {
    position: relative;
    display: inline-block;
  }

    .gold-btn {
    font-family: 'Montserrat', sans-serif;
    font-size: 20px;
    font-weight: 700;
    line-height: 1em;
    padding: 22px 58px;
    color: #fff;
    background-color: #000;
    border-radius: 8px;
    border: 1px solid var(--accent-gold);
    box-shadow: 0 8px 23px 0 rgba(255, 207, 35, .34);
    cursor: pointer;
    transition: all 0.3s ease-out;
  }

    .gold-btn:hover {
    background-color: var(--accent-gold);
    color: #000;
    box-shadow: 0 0 40px rgba(255, 207, 35, .5);
    transform: translateY(-2px);
  }

    .gold-btn:active {
    transform: translateY(0px);
    box-shadow: 0 4px 15px rgba(255, 207, 35, .25);
  }

  .dropdown-menu {
    position: absolute;
    top: 100%;
    left: 0;
    width: 100%;
    background: #000;
    border: 1px solid var(--accent-gold);
    border-radius: 10px;
    margin-top: 10px;
    opacity: 0;
    transform: translateY(-10px);
    pointer-events: none;
    transition: all .25s ease;
  }

  .dropdown-wrapper:hover .dropdown-menu {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .dropdown-menu a {
    display: block;
    padding: 14px 20px;
    color: white;
    border-bottom: 1px solid rgba(255,255,255,.1);
  }

  .dropdown-menu a:last-child {
    border-bottom: none;
  }

  .dropdown-menu a:hover {
    background: var(--accent-gold);
    color: black;
  }
</style>