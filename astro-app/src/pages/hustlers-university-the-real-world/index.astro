---
import Layout from "../../layouts/Layout.astro";
---

<Layout
  title="Hustlers University is Now The Real World"
  description="Official transition page from Hustlers University to The Real World."
>

<main class="relative min-h-screen text-white font-outfit">

  <!-- FIXED BACKGROUND -->
  <div class="fixed inset-0 -z-10 bg-cover bg-center bg-no-repeat"
       style="background-image:url('/background-placeholder.jpg')"></div>

  <!-- DARK OVERLAY -->
  <div class="fixed inset-0 -z-10 bg-[#061322]/90"></div>

  <!-- HERO -->
  <section class="pt-32 pb-20 text-center px-6">

    <div class="flex justify-center items-center gap-8 mb-10">

      <div class="opacity-40 relative w-28">
        <img src="/hu-logo.png" class="w-full" />
        <div class="absolute inset-0 flex items-center justify-center">
          <div class="w-full h-[2px] bg-red-500 rotate-12"></div>
        </div>
      </div>

      <span class="text-3xl text-white">→</span>

      <div class="w-32">
        <img src="/trw-logo.png" class="w-full" />
      </div>

    </div>

    <h1 class="text-4xl md:text-6xl font-semibold leading-tight">
      Hustlers University is Now
      <span class="text-white">The Real World</span>
    </h1>

    <p class="mt-6 max-w-2xl mx-auto text-white/70">
      The platform has evolved into a more advanced, structured system built for modern digital income and long-term skill development.
    </p>

  </section>

  <!-- CENTER CARD -->
  <section class="pb-32 px-6">

    <div class="max-w-2xl mx-auto bg-[#0A1B2F] border border-white/10 rounded-2xl p-10 md:p-14 text-center shadow-2xl backdrop-blur-sm">

      <h2 class="text-3xl md:text-4xl font-semibold mb-2">
        THE CHOICE IS YOURS
      </h2>

      <p class="text-white/60 mb-8">
        Secure Your Spot Before Pricing Increases
      </p>

      <!-- WISTIA PLACEHOLDER -->
      <div class="aspect-video bg-black rounded-xl mb-10"></div>

      <!-- URGENCY -->
      <h3 class="text-lg font-semibold">
        HURRY! SPACES LEFT AT $99 A MONTH
      </h3>

      <p class="text-white/60 mt-2 mb-8">
        As of February 28th is low
      </p>

      <!-- TIMER -->
      <div class="grid grid-cols-4 gap-6 mb-8 text-center font-outfit">
        <div>
          <div class="text-4xl">00</div>
          <div class="text-sm text-white/50">Days</div>
        </div>
        <div>
          <div class="text-4xl">00</div>
          <div class="text-sm text-white/50">Hours</div>
        </div>
        <div>
          <div class="text-4xl">00</div>
          <div class="text-sm text-white/50">Minutes</div>
        </div>
        <div>
          <div class="text-4xl">00</div>
          <div class="text-sm text-white/50">Seconds</div>
        </div>
      </div>

      <!-- GIF BAR PLACEHOLDER -->
      <div class="mb-10">
        <div class="h-6 bg-white/10 rounded-md">
          <!-- GIF placeholder -->
        </div>
      </div>

      <!-- CURRENT SPACES -->
      <p class="text-sm uppercase tracking-wide text-[#FFCF23] font-semibold mb-2">
        CURRENT SPACES LEFT
      </p>

      <div id="spacesLeft" class="text-6xl font-semibold mb-6 text-[#FFCF23]">
        312
      </div>

      <p class="text-white/70">
        Join The Real World & Lock-in Price for
      </p>

      <p class="mt-2 mb-6">
        <span class="line-through text-white/40">$147</span>
        <span class="text-white font-semibold">$99.99 / Monthly</span>
      </p>

      <!-- CTA BUTTON -->
      <div class="relative inline-block w-full max-w-sm font-montserrat">

        <button id="dropdownBtn"
          class="w-full py-4 rounded-xl text-white bg-black border border-[#FFCF23] transition-all duration-300 hover:bg-[#FFCF23] hover:text-black hover:shadow-[0_0_25px_rgba(255,207,35,0.35)]">
          JOIN THE REAL WORLD
        </button>

        <!-- DROPDOWN -->
        <div id="dropdownMenu"
          class="absolute bottom-full mb-2 w-full bg-black border border-[#FFCF23] rounded-xl overflow-hidden opacity-0 translate-y-4 pointer-events-none transition-all duration-300">

          <a href="#" class="block px-6 py-3 hover:bg-[#FFCF23] hover:text-black">
            Conquer (1 Month)
          </a>

          <a href="#" class="block px-6 py-3 hover:bg-[#FFCF23] hover:text-black">
            Conquer (1 Year)
          </a>

          <a href="#" class="block px-6 py-3 hover:bg-[#FFCF23] hover:text-black">
            Vanguard (1 Year)
          </a>

        </div>

      </div>

      <!-- DISCLAIMER LINE -->
      <p class="mt-8 text-xs text-white/50 flex items-center justify-center gap-2">
        <span class="text-lg">$</span> 
        Limited Spaces Available at $99 for February 28th. Before Price Increases to $147
        <span class="text-[#FFCF23]">Act fast.</span>
      </p>

    </div>

  </section>

</main>


</Layout>