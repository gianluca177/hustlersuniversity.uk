---
import Layout from "../../layouts/Layout.astro";
import DropdownButton from "../../components/Elements/DropdownButton.astro";
import Disclaimer from "../../components/Elements/Disclaimer.astro";
import PriceBlock from "../../components/Elements/PriceBlock.astro";
import BrandTransitionSectionV5 from "../../components/Containers/BrandTransitionSection-v5.astro";
import TransitionSection from "../../components/Sections/TransitionSection.astro";
import NavBarFunnel from "../../components/Elements/NavBarFunnel.astro";
import SpacesLeft from "../../components/Elements/SpacesLeft.astro";
import BackgroundLayer from "../../components/Elements/BackgroundLayer.astro";
---

<Layout
  title="Hustlers University is Now The Real World"
  description="Official transition page from Hustlers University to The Real World."
>

<main class="relative min-h-screen text-white font-outfit">

  <!-- NAVBAR FUNNEL -->
  <NavBarFunnel />

  <!-- FIXED BACKGROUND -->
  <BackgroundLayer 
    image="/hu-trw-background.webp" 
    overlayOpacity={0.95} 
   />
   
  <!-- HERO -->
  <section class="pt-32 pb-20 text-center px-6">

    <h1 class="text-4xl md:text-6xl font-semibold leading-tight">
      Hustlers University is Now
      <span class="text-white">The Real World</span>
    </h1>

    <p class="mt-6 max-w-2xl mx-auto text-white/70">
      The platform has evolved into a more advanced, structured system built for modern digital income and long-term skill development.
    </p>

  </section>

<!-- CENTER CARD -->
<TransitionSection>

    <p class="text-sm font-semi-bold !text-[var(--accent-gold)] underline underline-offset-4 decoration-2">
      ACT NOW TO SECURE YOUR SPOT
    </p>

    <BrandTransitionSectionV5 />

      <!-- CURRENT SPACES -->
      <SpacesLeft value={312} />

      <!-- PRICE -->
      <PriceBlock
        titleBefore="Join The Real World & "
        titleUnderline="Lock-in Price"
        titleAfter=" for"
        oldPrice="$147"
        newPrice="$99"
        billingText="/Monthly"
        ctaText="Act Now To Secure Your Spot"
        ctaLink="https://jointherealworld.com/checkout?a=7nrnndpb&subid=actnow"
      />

      <!-- CTA BUTTON -->
      <div class="relative inline-block w-full max-w-sm">
        <DropdownButton label="JOIN THE REAL WORLD" />
      </div>

      <!-- DISCLAIMER -->
      <Disclaimer
        icon="$"
        beforeText="Limited Spaces Available at $99 for "
        afterText="Before Price Increases to $147"
        highlightText="Act fast."
        dateId="dynamicDate2"
      />

</TransitionSection>

</main>


</Layout>